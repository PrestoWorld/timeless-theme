{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": []
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [],
			"fontSizes": []
		},
		"layout": {
			"contentSize": "100%",
			"wideSize": "100%"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": []
		},
		"border": {
			"defaultRadius": false
		},
		"custom": {
			"spacingUnits": ["px", "%", "em", "rem", "vh", "vw"]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base, #FAF9F5)",
			"text": "#1C1C1E"
		},
		"typography": {
			"fontFamily": "var(--font-sans)",
			"fontSize": "1rem",
			"lineHeight": "1.5"
		},
		"spacing": {
			"blockGap": "0",
			"padding": {
				"left": "0",
				"right": "0"
			},
			"margin": {
				"top": "0",
				"bottom": "0",
				"left": "0",
				"right": "0"
			}
		},
		"blocks": {}
	},
	"customTemplates": [],
	"templateParts": []
}
